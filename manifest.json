{
  "id": "home_connect",
  "name": "Home Connect",
  "version": "2.0.0",
  "description": "Home Connect appliances on Vestaboard Note. OAuth Device Flow. Portal labels: API Web Client ID, Fiestaboard Client ID, Fiestaboard Client Secret.",
  "author": "peterdgreenway",
  "icon": "home",
  "category": "data",
  "repository": "https://github.com/peterdgreenway/fiestaboard-plugin--home-connect",
  "documentation": "docs/SETUP.md",
  "min_refresh_seconds": 60,
  "teaser": "{66}{66} WASHER     ",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "{66}{66} WASHER     ",
        "PROG RUN       ",
        "42M LEFT       "
      ]
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "api_web_client_id": {
        "type": "string",
        "title": "API Web Client ID",
        "description": "Exactly as shown in the Home Connect developer portal (API Web Client ID).",
        "default": ""
      },
      "fiestaboard_client_id": {
        "type": "string",
        "title": "Fiestaboard Client ID",
        "description": "Client ID for this Fiestaboard application as shown in the Home Connect portal.",
        "default": ""
      },
      "fiestaboard_client_secret": {
        "type": "string",
        "title": "Fiestaboard Client Secret",
        "description": "Client secret from the Home Connect portal. Encrypted on Save.",
        "default": "",
        "ui:widget": "password"
      },
      "start_device_flow": {
        "type": "boolean",
        "title": "Start Device Flow (OAuth)",
        "description": "Turn ON and Save to begin Home Connect Device Flow. Open the verification URL, enter the user code, then leave this ON until tokens are stored. OAuth Flow type: Device Flow.",
        "default": false
      },
      "run_refresh_now": {
        "type": "boolean",
        "title": "Run refresh now",
        "description": "Save to fetch status immediately (ignores monitoring window).",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Auto refresh interval (seconds)",
        "description": "Default 300 (5 minutes) while monitoring is active.",
        "default": 300,
        "minimum": 60,
        "maximum": 3600
      },
      "monitor_window_enabled": {
        "type": "boolean",
        "title": "Enable monitoring time window",
        "default": true
      },
      "monitor_start": {
        "type": "string",
        "title": "Monitoring start time",
        "default": "07:30"
      },
      "monitor_end": {
        "type": "string",
        "title": "Monitoring stop time",
        "default": "23:45"
      },
      "use_simulator": {
        "type": "boolean",
        "title": "Use Home Connect simulator API",
        "default": false
      },
      "demo_mode": {
        "type": "boolean",
        "title": "Demo mode (no API)",
        "default": false
      },
      "appliance_filter": {
        "type": "string",
        "title": "Appliance name filter (optional)",
        "default": ""
      },
      "oauth_scopes": {
        "type": "string",
        "title": "OAuth scopes",
        "description": "Space-separated. Default includes IdentifyAppliance Monitor Control Settings.",
        "default": "IdentifyAppliance Monitor Control Settings"
      }
    }
  },
  "variables": {
    "simple": [
      "appliance_count",
      "name",
      "status",
      "detail",
      "note_row1",
      "note_row2",
      "note_row3",
      "note_block",
      "last_updated",
      "run_refresh_now",
      "refresh_seconds",
      "suggested_refresh_seconds",
      "refresh_mode",
      "monitor_window_active",
      "monitor_start",
      "monitor_end",
      "oauth_flow",
      "device_user_code",
      "device_verify_uri",
      "fiestaboard_client_id",
      "appliance_1_name",
      "appliance_1_status",
      "appliance_1_detail",
      "appliance_1_note_block",
      "appliance_1_note_row1",
      "appliance_1_note_row2",
