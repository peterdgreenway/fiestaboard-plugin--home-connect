{
  "id": "home_connect",
  "name": "Home Connect",
  "version": "2.7.0",
  "description": "Home Connect: 5-min poll, discovery cache 6h, programme calls only when needed, hard 900 API calls/day budget, last-good data on 429.",
  "author": "peterdgreenway",
  "icon": "home",
  "category": "data",
  "repository": "https://github.com/peterdgreenway/fiestaboard-plugin--home-connect",
  "documentation": "docs/SETUP.md",
  "min_refresh_seconds": 60,
  "teaser": "{66}{66} WASHER     ",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "{66}{66} WASHER     ",
        "PROG RUN       ",
        "42M LEFT       "
      ]
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "api_web_client_id": {
        "type": "string",
        "title": "API Web Client ID",
        "description": "As shown in the Home Connect developer portal.",
        "default": ""
      },
      "fiestaboard_client_id": {
        "type": "string",
        "title": "Fiestaboard Client ID",
        "description": "Client ID for this application from the Home Connect portal.",
        "default": ""
      },
      "fiestaboard_client_secret": {
        "type": "string",
        "title": "Fiestaboard Client Secret",
        "description": "Client secret from the portal. Encrypted on Save.",
        "default": "",
        "ui:widget": "password"
      },
      "refresh_token": {
        "type": "string",
        "title": "refresh_token",
        "description": "Priority 1. Used to obtain a new access_token from Home Connect. Encrypted on Save.",
        "default": "",
        "ui:widget": "password"
      },
      "id_token": {
        "type": "string",
        "title": "id_token",
        "description": "Priority 2. Used as Bearer if refresh_token is missing or fails. Encrypted on Save.",
        "default": "",
        "ui:widget": "password"
      },
      "access_token": {
        "type": "string",
        "title": "access_token",
        "description": "Priority 3. Direct API Bearer token if refresh_token and id_token are not used. Encrypted on Save.",
        "default": "",
        "ui:widget": "password"
      },
      "redirect_uri": {
        "type": "string",
        "title": "Redirect URI",
        "description": "Must match the Redirect URI registered on the Home Connect application exactly (e.g. http://localhost).",
        "default": "http://localhost"
      },
      "authorization_code": {
        "type": "string",
        "title": "Authorization code",
        "description": "After login, paste the code= value from the browser address bar, or the full redirect URL.",
        "default": "",
        "ui:widget": "password"
      },
      "get_oauth_tokens": {
        "type": "boolean",
        "title": "Get tokens via OAuth",
        "description": "Step 1: Save with Client ID/Secret/Redirect URI, open authorize_url, log in. Step 2: Paste the ?code= into Authorization code, turn this ON, Save \u2014 stores refresh_token, access_token, and id_token (encrypted).",
        "default": false
      },
      "exchange_authorization_code": {
        "type": "boolean",
        "title": "Exchange authorization code",
        "description": "Turn ON and Save to trade the authorization code for tokens (Authorization Code Grant Flow).",
        "default": false
      },
      "clear_stored_tokens": {
        "type": "boolean",
        "title": "Clear stored tokens",
        "description": "Turn ON and Save to wipe stored access/refresh tokens and force re-authorization.",
        "default": false
      },
      "run_refresh_now": {
        "type": "boolean",
        "title": "Run refresh now",
        "description": "Fetch appliance status immediately (ignores monitoring window).",
        "default": false
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Auto refresh interval (seconds)",
        "description": "Minimum and default 300 (5 minutes). Faster polling is blocked to stay under Home Connect rate limits.",
        "default": 300,
        "minimum": 300,
        "maximum": 3600
      },
      "monitor_window_enabled": {
        "type": "boolean",
        "title": "Enable monitoring time window",
        "default": true
      },
      "monitor_start": {
        "type": "string",
        "title": "Monitoring start time",
        "default": "07:30"
      },
      "monitor_end": {
        "type": "string",
        "title": "Monitoring stop time",
        "default": "23:45"
      },
      "use_simulator": {
        "type": "boolean",
        "title": "Use Home Connect simulator API",
        "default": false
      },
      "demo_mode": {
        "type": "boolean",
        "title": "Demo mode (no API)",
        "default": false
      },
      "appliance_filter": {
        "type": "string",
        "title": "Appliance name filter (optional)",
        "default": ""
      },
      "oauth_scopes": {
        "type": "string",
        "title": "OAuth scopes",
        "default": "IdentifyAppliance Monitor Control Settings"
      },
      "debug_log_secrets": {
        "type": "boolean",
        "title": "Debug: log full decrypted secrets",
        "description": "When ON, debug logs include full decrypted token values (sensitive). When OFF (default), only redacted previews are logged at DEBUG level.",
        "default": false
      }
    }
  },
