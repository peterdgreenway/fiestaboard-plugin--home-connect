      "appliance_2_detail",
      "appliance_2_note_block",
      "appliance_2_note_row1",
      "appliance_2_note_row2",
      "appliance_2_note_row3",
      "appliance_3_name",
      "appliance_3_status",
      "appliance_3_detail",
      "appliance_3_note_block",
      "appliance_3_note_row1",
